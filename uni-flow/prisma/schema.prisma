// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ToDoStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// Models
model User {
  id        String     @id @default(uuid())
  name      String
  role      Role       @default(STUDENT)
  email     String     @unique
  hash      String
  dob       DateTime?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  version   Int        @default(1)
  
  // Relations
  academicCourses AcademicCourse[]
  todos ToDo[]
  timerSessions TimerSession[]
}

model Instructor {
  id        String   @id @default(uuid())
  name      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  
  // Relations
  subjects  Subject[] @relation("CoordinatedSubjects")
  labSubjects Subject[] @relation("LabTutorSubjects")
}

model AcademicCourse {
  id        String   @id @default(uuid())
  degree     String
  credits     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  
  // Relations
  userId  String
  user    User @relation(fields: [userId], references: [id])
  terms Term[]
}

model Term {
  id                String   @id @default(uuid())
  title             String?
  academicYear      Int?
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  version           Int      @default(1)
  
  // Relations
  academicCourseId  String
  academicCourse    AcademicCourse @relation(fields: [academicCourseId], references: [id])
  subjects          Subject[]
}

model Subject {
  id           String   @id @default(uuid())
  title        String
  code         String
  credits      Int
  goalGrade    Float?
  actualGrade  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)
  
  // Relations
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  coordinatorId String?
  coordinator   Instructor? @relation("CoordinatedSubjects", fields: [coordinatorId], references: [id])
  labTutorId    String?
  labTutor      Instructor? @relation("LabTutorSubjects", fields: [labTutorId], references: [id])
  assessments   Assessment[]
  todos         ToDo[]
}

model Assessment {
  id          String   @id @default(uuid())
  title       String
  type        String
  description String?
  dueDate     DateTime
  weight      Float
  score       Float?
  maxScore    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  
  // Relations
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  todos       ToDo[]
}

model ToDo {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      ToDoStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  
  // Relations
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  subjectId    String?
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  timerSessions TimerSession[]
}

model TimerSession {
  id          String   @id @default(uuid())
  startTime   DateTime
  endTime     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  
  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  todoId      String?
  todo        ToDo? @relation(fields: [todoId], references: [id])
}
