// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ToDoStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// Models
model User {
  id        String     @id @default(uuid())
  name      String
  role      Role       @default(STUDENT)
  email     String     @unique
  hash      String
  dob       DateTime?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  version   Int        @default(1)
  
  // Relations
  subjects  Subject[] @relation("UserSubjects")
  assessments Assessment[]
  todoItems ToDo[]
  timerSessions TimerSession[]
}

model Instructor {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  
  // Relations
  subjects  Subject[] @relation("CoordinatedSubjects")
  labSubjects Subject[] @relation("LabTutorSubjects")
}

model AcademicCourse {
  id        String   @id @default(uuid())
  title     String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  
  // Relations
  terms Term[]
}

model Term {
  id                String   @id @default(uuid())
  title             String?
  currentAcademicYear Int?
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  version           Int      @default(1)
  
  // Relations
  academicCourseId  String
  academicCourse    AcademicCourse @relation(fields: [academicCourseId], references: [id])
  subjects          Subject[]
}

model Subject {
  id           String   @id @default(uuid())
  title        String
  code         String
  credits      Int
  goalGrade    Float?
  actualGrade  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)
  
  // Relations
  termId       String
  term         Term     @relation(fields: [termId], references: [id])
  coordinatorId String?
  coordinator  Instructor? @relation("CoordinatedSubjects", fields: [coordinatorId], references: [id])
  labTutorId    String?
  labTutor     Instructor? @relation("LabTutorSubjects", fields: [labTutorId], references: [id])
  assessments  Assessment[]
  todoItems    ToDo[]
  users        User[]   @relation("UserSubjects")
  timerSessions TimerSession[]
}

model Assessment {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  weight      Float
  grade       Float?
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  
  // Relations
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model ToDo {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  priority    String
  status      ToDoStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  
  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model TimerSession {
  id          String   @id @default(uuid())
  startTime   DateTime
  endTime     DateTime
  duration    Int      // in minutes
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  
  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}
